FROM python:3.11-slim
WORKDIR /app

RUN pip install "streamlit==1.45.*" --no-cache-dir

COPY src/llm_wiki/viewer/app.py .

# DATA_DIR is the read-only volume mount point; default matches docker-compose
ENV DATA_DIR=/data

EXPOSE 8501

CMD ["streamlit", "run", "app.py", \
     "--server.port=8501", \
     "--server.headless=true", \
     "--server.address=0.0.0.0"]
