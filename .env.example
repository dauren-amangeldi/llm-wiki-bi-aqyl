# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored — NEVER commit real keys/passwords.
# docker compose reads .env automatically (both for the app and for ${VAR}).

# --- LLM provider: openai | anthropic ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- PostgreSQL ---
# These configure the bundled postgres service AND the app's DATABASE_URL.
# Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD.
POSTGRES_USER=llmwiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llmwiki
DATABASE_URL=postgresql+psycopg://llmwiki:change-me@postgres:5432/llmwiki
# In prod with a managed DB, either set DATABASE_URL directly, OR — following the
# BI platform convention — set POSTGRES_HOST (and optionally POSTGRES_PORT) and
# the app assembles DATABASE_URL from POSTGRES_HOST/PORT/USER/PASSWORD/DB:
# POSTGRES_HOST=DC2TZEBODB01
# POSTGRES_PORT=5432

# --- Redis (Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Vector store ---
# Vectors live inside PostgreSQL via the pgvector extension — no separate service.
# The managed Postgres must have the extension available (CREATE EXTENSION vector);
# the bundled dev image (pgvector/pgvector:pg16) already includes it.

# --- Object storage (raw uploads + wiki pages) ---
# local = files under DATA_DIR (dev only — needs a persistent volume).
# s3   = S3/MinIO. REQUIRED IN PROD: the cluster gives no persistent volumes,
#        so all raw uploads and generated wiki .md live in object storage and
#        the app pods stay fully stateless / horizontally scalable.
STORAGE_BACKEND=local
S3_ENDPOINT=minio:9000     # prod: your S3 endpoint host:port, no scheme
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=llm-wiki
S3_SECURE=false            # prod: true for https S3 endpoints
DATA_DIR=/app/data         # only used when STORAGE_BACKEND=local

# ============================================================================
# PROD (stateless — no persistent volumes on the app pods)
# ----------------------------------------------------------------------------
# Point every stateful dependency at an externally-managed instance and drop
# the bundled postgres/redis/minio services:
#   STORAGE_BACKEND=s3
#   S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET / S3_SECURE  → S3
#   DATABASE_URL   → managed PostgreSQL (with the pgvector extension enabled)
#   REDIS_URL      → managed Redis
# Vectors live inside that same Postgres (pgvector) — no separate vector service.
# With this, api/worker/beat hold no local state and can be scaled/replaced
# freely (only the API port is published; nothing else is exposed).
# ============================================================================

# --- Ports ---
API_PORT=8000        # host port for the API (internal services are not exposed)

# --- Embeddings (always OpenAI; OPENAI_API_KEY above is reused) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=1536

# --- Search tuning ---
SEARCH_TOP_K=20
SEARCH_SIMILARITY_THRESHOLD=0.3
SEARCH_FINAL_K_MAX=10

# --- Auth (Keycloak / OIDC) ---
# false → app trusts X-User-Email (dev/demo, current default). true → API
# requires a valid Keycloak access token (bearer JWT verified via JWKS).
AUTH_ENABLED=false
KEYCLOAK_URL=https://sso.test.bi.group
KEYCLOAK_REALM=bi-group
# Instead of KEYCLOAK_URL + KEYCLOAK_REALM you can give the full realm issuer
# directly (BI platform convention); it overrides the two above:
# KEYCLOAK_ISSUER=https://sso.test.bi.group/realms/bi-group
KEYCLOAK_CLIENT_ID=ai-office-bi-aqyl
KEYCLOAK_CLIENT_SECRET=          # confidential client secret — set in prod, never commit
# Browser-facing origin of this app (OIDC redirect_uri + post-login redirect),
# e.g. https://ai-office.bi.group. Empty → derived from the request.
# Also accepts FRONTEND_URL (BI platform convention) as an alias.
PUBLIC_BASE_URL=
# With AUTH_ENABLED=true, a valid Keycloak login is NOT enough — the email must
# also be whitelisted in the allowed_users table (strict whitelist); admins are
# rows with is_admin=true. demo@bi.group is seeded on a fresh DB. Manage entries:
#   docker compose exec api uv run python scripts/manage_access.py list
#   docker compose exec api uv run python scripts/manage_access.py add x@bi.group --admin
#   docker compose exec api uv run python scripts/manage_access.py block x@bi.group

# --- App ---
WIKI_LANGUAGE=ru
LOG_LEVEL=INFO
# CORS_ORIGINS=["https://your-frontend-domain"]
