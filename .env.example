# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored — NEVER commit real keys/passwords.
# docker compose reads .env automatically (both for the app and for ${VAR}).

# --- LLM provider: openai | anthropic ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- PostgreSQL ---
# These configure the bundled postgres service AND the app's DATABASE_URL.
# Keep the password in DATABASE_URL identical to POSTGRES_PASSWORD.
POSTGRES_USER=llmwiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llmwiki
DATABASE_URL=postgresql+psycopg://llmwiki:change-me@postgres:5432/llmwiki
# In prod with a managed DB, set DATABASE_URL to its host and ignore POSTGRES_*.

# --- Redis (Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Vector store (ChromaDB) ---
# http = external/bundled Chroma server (recommended). local = embedded on disk.
CHROMA_BACKEND=http
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Object storage (raw uploads + wiki pages) ---
# local = files under DATA_DIR (dev only — needs a persistent volume).
# s3   = S3/MinIO. REQUIRED IN PROD: the cluster gives no persistent volumes,
#        so all raw uploads and generated wiki .md live in object storage and
#        the app pods stay fully stateless / horizontally scalable.
STORAGE_BACKEND=local
S3_ENDPOINT=minio:9000     # prod: your S3 endpoint host:port, no scheme
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=llm-wiki
S3_SECURE=false            # prod: true for https S3 endpoints
DATA_DIR=/app/data         # only used when STORAGE_BACKEND=local

# ============================================================================
# PROD (stateless — no persistent volumes on the app pods)
# ----------------------------------------------------------------------------
# Point every stateful dependency at an externally-managed instance and drop
# the bundled postgres/redis/chroma/minio services:
#   STORAGE_BACKEND=s3
#   S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET / S3_SECURE  → S3
#   DATABASE_URL   → managed PostgreSQL
#   REDIS_URL      → managed Redis
#   CHROMA_BACKEND=http, CHROMA_HOST / CHROMA_PORT → managed/hosted Chroma
# With this, api/worker/beat hold no local state and can be scaled/replaced
# freely (only the API port is published; nothing else is exposed).
# ============================================================================

# --- Ports ---
API_PORT=8000        # host port for the API (internal services are not exposed)

# --- Embeddings (always OpenAI; OPENAI_API_KEY above is reused) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=1536

# --- Search tuning ---
SEARCH_TOP_K=20
SEARCH_SIMILARITY_THRESHOLD=0.3
SEARCH_FINAL_K_MAX=10

# --- App ---
WIKI_LANGUAGE=ru
LOG_LEVEL=INFO
# CORS_ORIGINS=["https://your-frontend-domain"]
