# Copy this file to .env.testing or .env.staging and fill in real values.
# NEVER commit .env.staging (contains real API keys).

# --- LLM Provider: ollama | openai | anthropic ---
LLM_PROVIDER=ollama

# --- Ollama (testing only) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# --- OpenAI (staging/prod) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# --- Anthropic (fallback) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite+aiosqlite:///data/metadata.db
DATA_DIR=/app/data

# --- Embeddings (always OpenAI, even when LLM_PROVIDER=ollama) ---
# OPENAI_API_KEY above is also used for text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=1536

# --- Search tuning ---
SEARCH_TOP_K=20
SEARCH_SIMILARITY_THRESHOLD=0.3
SEARCH_FINAL_K_MAX=10

# --- Observability ---
LOG_LEVEL=DEBUG
