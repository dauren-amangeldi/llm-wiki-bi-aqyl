# Copy this file to .env and fill in real values.
# NEVER commit a file with real API keys (.env is gitignored).

# --- LLM Provider: openai | anthropic ---
LLM_PROVIDER=openai

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini

# --- Anthropic (alternative) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
# PostgreSQL is required (no SQLite). In prod point this at the managed instance.
DATABASE_URL=postgresql+psycopg://llmwiki:llmwiki@postgres:5432/llmwiki
DATA_DIR=/app/data

# --- Vector store (ChromaDB) ---
# local = embedded on disk (dev). http = external Chroma server (prod).
CHROMA_BACKEND=local
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Object storage for raw uploads + wiki pages ---
# local  = files under DATA_DIR (dev). s3 = S3/MinIO (production — pods are
# ephemeral and must not hold data).
STORAGE_BACKEND=local
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=llm-wiki
S3_SECURE=false

# --- Embeddings (always OpenAI) ---
# OPENAI_API_KEY above is also used for text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSIONS=1536

# --- Search tuning ---
SEARCH_TOP_K=20
SEARCH_SIMILARITY_THRESHOLD=0.3
SEARCH_FINAL_K_MAX=10

# --- Observability ---
LOG_LEVEL=DEBUG
