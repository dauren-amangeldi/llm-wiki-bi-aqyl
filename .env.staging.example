# Staging template — copy to .env.staging.local and fill in OPENAI_API_KEY.
# NEVER commit .env.staging.local.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://llmwiki:llmwiki@postgres:5432/llmwiki
DATA_DIR=/app/data

# Object storage: local (dev) | s3 (prod)
STORAGE_BACKEND=local

LOG_LEVEL=INFO
WIKI_LANGUAGE=ru
