# Staging template — copy to .env.staging.local and fill in OPENAI_API_KEY.
# NEVER commit .env.staging.local.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite+aiosqlite:///data/metadata.db
DATA_DIR=/app/data

LOG_LEVEL=INFO
WIKI_LANGUAGE=ru
